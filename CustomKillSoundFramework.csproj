<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>CustomKillSoundFramework</AssemblyName>
    <RootNamespace>CustomKillSoundFramework</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <!-- No PDB / embedded source paths: the release DLL carries no machine-specific
         path or branding from the folder it happened to be built in. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!--
    GameDir and InteropDir are machine-specific. Supply them in Directory.Build.props
    (copy the .example file) or on the command line with -p:GameDir="..." -p:InteropDir="...".
  -->
  <PropertyGroup>
    <InteropDir Condition="'$(InteropDir)' == ''">$(MSBuildProjectDirectory)\..\..\interop</InteropDir>
  </PropertyGroup>

  <Target Name="ValidatePaths" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameDir)' == ''"
           Text="GameDir is not set. Copy Directory.Build.props.example to Directory.Build.props and edit it, or pass -p:GameDir=&quot;...&quot;." />
  </Target>

  <ItemGroup>
    <!-- The cfg template is embedded so a fresh install always gets bilingual comments. -->
    <EmbeddedResource Include="Custom_Kill_Sound_Framework.cfg" LogicalName="CustomKillSoundFramework.Default.cfg" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx 6 IL2CPP runtime -->
    <Reference Include="BepInEx.Core">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- IL2CPP interop assemblies generated by BepInEx -->
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(InteropDir)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(InteropDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(InteropDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(InteropDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(InteropDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    This is a FRAMEWORK: it ships NO sound files at all. Players put their own
    .wav files into the Sounds folder, named by the rules in the cfg template.
    Nothing from the source tree is copied as audio.
  -->

  <!-- Pass -p:InstallToGame=true to install the DLL and cfg into the game. -->
  <Target Name="InstallToGame" AfterTargets="Build" Condition="'$(InstallToGame)' == 'true'">
    <MakeDir Directories="$(GameDir)\BepInEx\plugins\Custom Kill Sound Framework\Sounds" />
    <MakeDir Directories="$(GameDir)\BepInEx\config" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(GameDir)\BepInEx\plugins\Custom Kill Sound Framework" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Custom_Kill_Sound_Framework.cfg"
          DestinationFiles="$(GameDir)\BepInEx\config\Custom_Kill_Sound_Framework.cfg"
          Condition="!Exists('$(GameDir)\BepInEx\config\Custom_Kill_Sound_Framework.cfg')" />
    <Message Text="Installed the DLL and cfg template. Put your own .wav files in BepInEx\plugins\Custom Kill Sound Framework\Sounds" Importance="high" />
  </Target>

</Project>
